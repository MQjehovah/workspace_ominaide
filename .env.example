# Database
DATABASE_URL=mysql+aiomysql://omniaide:omniaide_pass@mysql:3306/omniaide

# MinIO
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=omniaide_minio
MINIO_SECRET_KEY=omniaide_minio_secret
# Public reverse-proxy base for presigned URLs (nginx strips /minio and keeps
# Host=minio:9000 so SigV4 still validates).
MINIO_PUBLIC=false
MINIO_PUBLIC_URL=

# Qdrant
QDRANT_URL=http://qdrant:6333

# Redis
REDIS_URL=redis://redis:6379/0

# LLM (初期使用云端 API)
LLM_PROVIDER=openai
LLM_API_KEY=sk-your-key-here
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# Embeddings (Notes RAG / semantic search). Leave the key empty to fall back to
# LLM_API_KEY. If the provider has no embedding endpoint, keyword BM25 still works.
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536

# Scheduled and event-driven AI work lives in Bot Console → triggers.
# The backend only fetches mail/sources/DingTalk and sends reminders without calling
# the LLM. The daily "每日记忆整理" routine does the memory analysis.
MEMORY_AUTO_APPROVE_THRESHOLD=85
SOURCES_REFRESH_ENABLED=true
SOURCES_REFRESH_INTERVAL_SECONDS=1800
# RSSHub base URL for GitHub Trending and future providers (self-host recommended).
RSSHUB_BASE_URL=
DINGTALK_SYNC_ENABLED=true
DINGTALK_SYNC_HOUR=1
DINGTALK_SYNC_MINUTE=45
DINGTALK_SYNC_HOURS=24
DINGTALK_SYNC_MAX_MESSAGES=200

# Notes RAG (chunking + hybrid retrieval)
NOTES_RAG_ENABLED=true
NOTES_CHUNK_SIZE=600
NOTES_CHUNK_OVERLAP=80
NOTES_RAG_TOP_K=8
NOTES_RAG_RECALL_K=30
NOTES_RAG_MMR_LAMBDA=0.7

# Persistent runtime data. Production mounts one host directory:
#   /data/docker/omniaide/data -> /data
# Every user gets /data/workspace/<user_id> with projects/, dingtalk/ and tmp/.
# DingTalk config/tokens live with the user, not in the server-level /config.
WORKSPACE_ROOT=/data/workspace
SKILLS_DIR=/data/skills
DESKTOP_PLUGINS_DIR=/data/desktop_plugins

# Server-side coding agent. The agent runs inside the backend container and
# operates only on the current user's projects directory
# (<WORKSPACE_ROOT>/<user_id>/projects). CODING_WORKSPACE_ROOT is a legacy/test
# override; leave it empty in production. When CODING_AUTO_DELIVER is on, the
# agent's own git commit/push tools are disabled and the backend does
# verify -> branch -> commit -> push after the task finishes.
CODING_WORKSPACE_ROOT=
CODING_MAX_TURNS=40
CODING_AUTO_DELIVER=true
CODING_AUTO_PUSH=true
CODING_VERIFY_COMMAND=
CODING_BRANCH_PREFIX=feature/
CODING_SSH_KEY_PATH=/config/ssh/id_rsa
# Model-driven commands and the verify command run as this unprivileged user
# with a scrubbed environment (no DATABASE_URL / LLM key / JWT secret). Fallback
# to the current user only when the backend is not root or the user is missing.
CODING_SANDBOX_ENABLED=true
CODING_SANDBOX_USER=agent
CODING_SANDBOX_HOME=/home/agent
# Global cap; tasks on the same working tree are serialized on top of this.
CODING_MAX_CONCURRENCY=2

# Speech (ASR / TTS). Defaults wrap Zhipu bigmodel (used by the SmartAssistant
# firmware). ASR_API_KEY / TTS_API_KEY fall back to LLM_API_KEY when empty.
ASR_API_KEY=
ASR_BASE_URL=https://ai.xzrobot.com/v1
ASR_MODEL=voice-asr
ASR_VERBOSE_JSON=false
ASR_DIARIZE=false
ASR_MAX_AUDIO_MB=0
# Long meeting recordings are streamed from MinIO as one object; no 25MB cap.
ASR_TIMEOUT_SECONDS=3600
MEETING_ASR_CONCURRENCY=1
TTS_API_KEY=
TTS_BASE_URL=https://ai.xzrobot.com/v1
TTS_MODEL=voice-tts
TTS_VOICE=default
TTS_FORMAT=wav
TTS_SEND_FORMAT=false
# TTS provider for voice streaming: "edge" (low latency, no key) or "zhipu".
# edge-tts streams MP3 over a WebSocket; the gateway returns the full WAV only
# when synthesis finishes. The pipeline falls back to the other path on failure.
TTS_PROVIDER=edge
TTS_EDGE_VOICE=zh-CN-XiaoxiaoNeural

# Weather (Open-Meteo, no API key). Leave empty to disable weather entirely.
# Example for Shanghai: 31.2222 / 121.4581
WEATHER_LAT=
WEATHER_LON=

# Personal assistant agent
ASSISTANT_SYSTEM_PROMPT=
CHAT_HISTORY_LIMIT=20

# JWT
JWT_SECRET=change-this-to-a-random-secret
JWT_REFRESH_SECRET=change-this-to-a-different-random-secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# CORS (JSON array of allowed origins; include '*' to allow all without credentials)
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","app://."]

# Server
API_HOST=0.0.0.0
API_PORT=8000
