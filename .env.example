# Database
DATABASE_URL=mysql+aiomysql://omniaide:omniaide_pass@mysql:3306/omniaide

# MinIO
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=omniaide_minio
MINIO_SECRET_KEY=omniaide_minio_secret
# Public reverse-proxy base for presigned URLs (nginx strips /minio and keeps
# Host=minio:9000 so SigV4 still validates).
MINIO_PUBLIC=false
MINIO_PUBLIC_URL=

# Qdrant
QDRANT_URL=http://qdrant:6333

# Redis
REDIS_URL=redis://redis:6379/0

# LLM (初期使用云端 API)
LLM_PROVIDER=openai
LLM_API_KEY=sk-your-key-here
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# Embeddings (Notes RAG / semantic search). Leave the key empty to fall back to
# LLM_API_KEY. If the provider has no embedding endpoint, keyword BM25 still works.
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536

# Notes RAG (chunking + hybrid retrieval)
NOTES_RAG_ENABLED=true
NOTES_CHUNK_SIZE=600
NOTES_CHUNK_OVERLAP=80
NOTES_RAG_TOP_K=8
NOTES_RAG_RECALL_K=30
NOTES_RAG_MMR_LAMBDA=0.7

# Speech (ASR / TTS). Defaults wrap Zhipu bigmodel (used by the SmartAssistant
# firmware). ASR_API_KEY / TTS_API_KEY fall back to LLM_API_KEY when empty.
ASR_API_KEY=
ASR_BASE_URL=https://open.bigmodel.cn/api/paas/v4
ASR_MODEL=glm-asr
TTS_API_KEY=
TTS_BASE_URL=https://open.bigmodel.cn/api/paas/v4
TTS_MODEL=glm-tts
TTS_VOICE=tongtong
TTS_FORMAT=wav

# Personal assistant agent
ASSISTANT_SYSTEM_PROMPT=
CHAT_HISTORY_LIMIT=20

# JWT
JWT_SECRET=change-this-to-a-random-secret
JWT_REFRESH_SECRET=change-this-to-a-different-random-secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# CORS (JSON array of allowed origins; include '*' to allow all without credentials)
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","app://."]

# Server
API_HOST=0.0.0.0
API_PORT=8000
