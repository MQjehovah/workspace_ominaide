{
  "name": "device",
  "version": "1.1.0",
  "title": "设备接入",
  "description": "智能助手硬件接入：摘要、设备事件、Home Assistant、计时器与音乐播放",
  "icon": "Smartphone",
  "permissions": [],
  "routes": {
    "main": "/apps/device"
  },
  "tools": [
    {
      "name": "ha_call_service",
      "description": "调用 Home Assistant 服务（控制智能家居：开/关灯、开关、场景、脚本等）",
      "inputSchema": {
        "type": "object",
        "properties": {
          "domain": {"type": "string", "description": "服务域，如 light/switch/climate/script/input_boolean/fan/cover"},
          "service": {"type": "string", "description": "服务名，如 toggle/turn_on/turn_off"},
          "entity_id": {"type": "string", "description": "实体 ID，如 light.desk_lamp"},
          "data": {"type": "object", "description": "附加参数（如亮度、色温），可省略"}
        },
        "required": ["domain", "service"]
      }
    },
    {
      "name": "ha_get_state",
      "description": "查询 Home Assistant 实体的当前状态（如灯是否开着、当前温度）",
      "inputSchema": {
        "type": "object",
        "properties": {
          "entity_id": {"type": "string", "description": "实体 ID，如 light.desk_lamp"}
        },
        "required": ["entity_id"]
      }
    },
    {
      "name": "ha_toggle",
      "description": "翻转一个 Home Assistant 实体（开关灯/插座/勿扰开关等，script 则执行）",
      "inputSchema": {
        "type": "object",
        "properties": {
          "entity_id": {"type": "string", "description": "实体 ID，如 light.desk_lamp"}
        },
        "required": ["entity_id"]
      }
    },
    {
      "name": "set_device_timer",
      "description": "在用户的智能助手硬件上启动一个本地倒计时/计时器（如“定个 10 分钟计时器”）。到点设备会响铃并提示。",
      "inputSchema": {
        "type": "object",
        "properties": {
          "seconds": {"type": "integer", "description": "倒计时秒数，1..86400"},
          "label": {"type": "string", "description": "计时器名称，如“煮面”"}
        },
        "required": ["seconds"]
      }
    },
    {
      "name": "play_device_music",
      "description": "让用户的智能助手硬件开始播放音乐（默认播放全部音频文件，也可指定歌单）。",
      "inputSchema": {
        "type": "object",
        "properties": {
          "playlist_id": {"type": "integer", "description": "歌单 ID；0 或不传表示全部音频"},
          "title": {"type": "string", "description": "可选的播放提示名称"}
        }
      }
    },
    {
      "name": "device_music_control",
      "description": "控制智能助手硬件的音乐播放：play 开始、stop 停止、next 下一首。",
      "inputSchema": {
        "type": "object",
        "properties": {
          "action": {"type": "string", "enum": ["play", "stop", "next"], "description": "控制动作"}
        },
        "required": ["action"]
      }
    }
  ]
}
