{
  "name": "omniaide-vibecoding-proxy",
  "version": "1.0.0",
  "displayName": "VibeCoding Proxy",
  "description": "项目内运行 opencode/claude/codex 编程 agent，通过飞书/Telegram/Webhook 远程代理执行",
  "main": "dist/index.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build && vite build --config vite.frontend.config.ts"
  },
  "omniaide": {
    "id": "vibecoding-proxy",
    "displayName": "VibeCoding Proxy",
    "icon": "FolderOpened",
    "keywords": [
      "vibecoding",
      "project",
      "terminal",
      "opencode",
      "claude",
      "codex",
      "飞书",
      "feishu",
      "telegram",
      "webhook",
      "通道",
      "proxy"
    ],
    "permissions": [
      "storage",
      "notification",
      "shell"
    ],
    "builtin": false
  },
  "dependencies": {
    "protobufjs": "^8.7.1",
    "vue": "^3.5.40",
    "ws": "^8.21.1"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.2.4",
    "typescript": "~5.6.0",
    "vite": "^5.2.0"
  }
}
