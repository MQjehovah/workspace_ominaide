{
  "name": "omniaide-translator",
  "version": "1.0.0",
  "displayName": "翻译助手",
  "description": "划词/输入快速翻译，支持多语言（中英日韩法等）",
  "main": "dist/index.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build"
  },
  "omniaide": {
    "id": "translator",
    "displayName": "翻译助手",
    "icon": "Reading",
    "keywords": ["translate", "翻译", "translation"],
    "permissions": ["storage"],
    "builtin": true
  },
  "devDependencies": {
    "vite": "^5.2.0",
    "@vitejs/plugin-vue": "^5.2.4",
    "vue": "^3.5.40",
    "typescript": "~5.6.0"
  }
}
