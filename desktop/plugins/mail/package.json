{
  "name": "omniaide-mail",
  "version": "1.0.2",
  "displayName": "邮件",
  "description": "聚合多个邮箱，接收和发送邮件",
  "main": "dist/index.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build"
  },
  "omniaide": {
    "id": "mail",
    "displayName": "邮件",
    "icon": "Message",
    "keywords": [
      "mail",
      "email"
    ],
    "permissions": [
      "storage",
      "notification",
      "shell",
      "api"
    ],
    "builtin": true,
    "version": "1.0.2",
    "activation": "lazy"
  },
  "devDependencies": {
    "vite": "^5.2.0",
    "@vitejs/plugin-vue": "^5.2.4",
    "vue": "^3.5.40",
    "typescript": "~5.6.0"
  }
}
