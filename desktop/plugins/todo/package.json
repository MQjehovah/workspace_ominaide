{
  "name": "omniaide-todo",
  "version": "1.0.2",
  "displayName": "待办事项",
  "description": "管理待办事项，支持自然语言创建",
  "main": "dist/index.js",
  "scripts": {
    "build": "vite build"
  },
  "omniaide": {
    "id": "todo",
    "displayName": "待办事项",
    "icon": "Check",
    "keywords": [
      "todo",
      "task"
    ],
    "permissions": [
      "storage",
      "notification",
      "api"
    ],
    "builtin": true,
    "version": "1.0.2",
    "activation": "lazy"
  },
  "devDependencies": {
    "vite": "^5.2.0",
    "@vitejs/plugin-vue": "^5.2.4",
    "vue": "^3.5.40"
  }
}
