      "voice"
    ],
    "permissions": [
      "storage",
      "notification",
      "shell"
    ],
    "builtin": true
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.2.4",
    "typescript": "~5.6.0",
    "vite": "^5.2.0",
    "vue": "^3.5.40"
  },
  "dependencies": {
    "highlight.js": "^11.11.1",
    "marked": "^18.0.9"
  }
}
