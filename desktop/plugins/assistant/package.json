{
  "name": "omniaide-assistant",
  "version": "1.0.0",
  "displayName": "AI 助理",
  "description": "桌面 AI 助理——语音对话、自然语言操作",
  "main": "dist/index.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build"
  },
  "omniaide": {
    "id": "assistant",
    "displayName": "AI 助理",
