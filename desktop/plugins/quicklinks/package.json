{
  "name": "omniaide-quicklinks",
  "version": "1.0.2",
  "displayName": "快捷指令",
  "description": "一键打开软件 / 网页 / 文件夹 / 运行脚本与命令，图标网格面板",
  "main": "dist/index.js",
  "scripts": {
    "build": "vite build"
  },
  "omniaide": {
    "id": "quicklinks",
    "displayName": "快捷指令",
    "icon": "Zap",
    "keywords": [
      "quick",
      "快捷",
      "启动",
      "app",
      "命令"
    ],
    "permissions": [
      "storage",
      "shell",
      "shell:exec"
    ],
    "builtin": true,
    "version": "1.0.2",
    "activation": "lazy"
  },
  "devDependencies": {
    "vite": "^5.2.0",
    "@vitejs/plugin-vue": "^5.2.4",
    "vue": "^3.5.40"
  }
}
