/**
 * 本地私有配置示例。
 *
 * 复制为 device/config.local.h 后填入真实值；该文件已被 .gitignore 忽略。
 * 也可以留空，首次开机通过设备「设置 → 配网模式」写入 NVS。
 */
#pragma once

#define WIFI_SSID       "your-wifi"
#define WIFI_PASS       "your-wifi-password"

// 推荐外网 HTTPS（设备可在任何地方使用）。
// ESP-SR 已把任务移到 core 0、LVGL 对象放 PSRAM，并保留 20 行内部绘制缓冲，
// 因此 HTTPS 也能保持界面流畅。
#define OMNIAIDE_URL    "https://your-server/ominaide"
#define OMNIAIDE_USER   "your-user"
#define OMNIAIDE_PASS   "your-password"

// 可选：内网 HTTP 更快、更省 RAM；如果只在家用，可改成：
// #define OMNIAIDE_URL "http://192.168.2.10:8000"

// 可选：填 CA 根证书启用 TLS 校验；留空跳过（内网/frp 场景）
// #define TLS_CA_CERT  R"EOF(
// -----BEGIN CERTIFICATE-----
// ...
// -----END CERTIFICATE-----
// )EOF"
